{
  "name": "@daikiito-dk/slate-excel-form",
  "version": "0.1.0",
  "private": false,
  "author": "Daiki Ito",
  "main": "main.js",
  "description": "Local-first, AI-ready forms for existing Excel templates.",
  "repository": {
    "type": "git",
    "url": "https://github.com/daikiito-dk/Slate.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "test": "node --check app.js && node --check main.js && node --check preload.js",
    "start": "electron .",
    "dist:mac": "electron-builder --mac zip"
  },
  "dependencies": {
    "jszip": "^3.10.1"
  },
  "devDependencies": {
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.daikiito.slate",
    "productName": "Slate",
    "copyright": "Copyright © 2026 Daiki Ito",
    "files": [
      "**/*",
      "!output{,/**}",
      "!dist{,/**}"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": ["zip"]
    }
  }
}
